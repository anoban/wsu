namespace stats {
    // for a continuous random variable x with an inclusive range [a, b], its cumulative distribution function cdf(x) is defined as P(x<=X)
    // i.e the probability of x being less than or equal to the values in the X distribution

    namespace t {
        // cumulative distribution function of student's t distribution - two tailed
        static constexpr inline long double __stdcall cdf(
            _In_ const long double& quantile, // quantile
            _In_ const long long&   dof,      // degrees of freedom = sample size - 1
            _In_ const long double& loc,      // mean
            _In_ const long double& scale     // std
        ) noexcept {
            //
        }



        // percent point function of student's t distribution, inverse of cdf
        static constexpr inline long double __stdcall ppf(
            _In_ const long double& quantile, _In_ const long long& dof, _In_ const long double& loc, _In_ const long double& scale
        ) noexcept { }
    } // namespace t

    namespace f {
        static constexpr inline long double __stdcall ppf() noexcept { }
    } // namespace f

    namespace norm {
        static constexpr inline long double __stdcall cdf() noexcept { }
    } // namespace norm

